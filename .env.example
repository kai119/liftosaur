# Self-hosted production configuration. Ignored entirely in dev mode
# (NODE_ENV != production), which reads localdomain.js instead.

# Required in production: the single public origin the whole stack is
# served from (web app, API, and streaming API all collapse onto this).
# Example: https://lift.bambermumford.co.uk
HOST=

# Port the Node server listens on internally. Caddy (or your reverse
# proxy) forwards to this port. Defaults to 3000 if unset.
SERVER_PORT=3000

# DynamoDB-compatible endpoint (ScyllaDB Alternator or DynamoDB Local).
# Defaults to http://localhost:8000 if unset.
DYNAMO_ENDPOINT=http://localhost:8000

# S3-compatible object storage endpoint (MinIO). Defaults to
# http://localhost:9000 if unset.
S3_ENDPOINT=http://localhost:9000
